"""CLI: policy.rego → Lua on stdout (check --strict, then IR → Lua)."""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

ROOT = os.path.dirname(os.path.abspath(__file__))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from ir2lua import __version__
from ir2lua.translate import TranslateError, translate_plan
from opa_plan import OpaError, build_ir_plan


def _parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="rego2lua",
        usage="rego2lua [-d FILE] <policy.rego>",
        description="Compile a Rego policy to Lua via OPA plan IR.",
    )
    p.add_argument(
        "-V",
        "--version",
        action="version",
        version=f"rego2lua {__version__}",
    )
    p.add_argument("-d", "--dump-plan", metavar="FILE")
    p.add_argument("policy", metavar="policy.rego")
    return p.parse_args(argv)


def check_rego(rego_path: str) -> None:
    """Parse and compile ``rego_path`` with ``opa check --strict``."""
    try:
        proc = subprocess.run(
            ["opa", "check", "--strict", rego_path],
            capture_output=True,
            text=True,
        )
    except FileNotFoundError as e:
        raise OpaError("opa not found on PATH") from e
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        raise OpaError(f"opa check failed (exit {proc.returncode}): {detail}")


def main(argv: list[str] | None = None) -> int:
    args = _parse_args(argv)
    if not Path(args.policy).is_file():
        sys.stderr.write(f"rego2lua: not a file: {args.policy}\n")
        return 2
    try:
        check_rego(args.policy)
        plan, package = build_ir_plan(args.policy, dump_plan=args.dump_plan)
        lua = translate_plan(plan, package)
    except (OpaError, TranslateError, OSError) as e:
        sys.stderr.write(f"rego2lua: {e}\n")
        return 1
    sys.stdout.write(lua)
    if not lua.endswith("\n"):
        sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
